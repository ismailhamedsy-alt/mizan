<Window x:Class="MizanDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الميزان للمحاسبة" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Sidebar}">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="الميزان" Foreground="White" FontSize="30" FontWeight="Bold" Margin="8,12,8,2"/>
                    <TextBlock Text="نظام المحاسبة وإدارة المبيعات" Foreground="#94A3B8" FontSize="12" Margin="8,0,8,24"/>
                    <Button Content="⌂  لوحة التحكم" Click="Dashboard_Click"/>
                    <Button Content="▣  المبيعات" Click="Sales_Click"/>
                    <Button Content="↩  مرتجعات المبيعات" Click="SalesReturns_Click"/>
                    <Button Content="🧾  عروض الأسعار" Click="Quotations_Click"/>
                    <Button Content="▤  المشتريات" Click="Purchases_Click"/>
                    <Button Content="↪  مرتجعات المشتريات" Click="PurchaseReturns_Click"/>
                    <Button Content="▦  المنتجات والمخزون" Click="Products_Click"/>
                    <Button Content="♙  العملاء والموردون" Click="Parties_Click"/>
                    <Button Content="💰  الصندوق" Click="Cash_Click"/>
                    <Button Content="📦  الجرد والمخزون" Click="Inventory_Click"/>
                    <Button Content="🧮  الجرد والتسوية" Click="InventoryAudit_Click"/>
                    <Button Content="🧱  طبقات تكلفة المخزون" Click="CostLayers_Click"/>
                    <Button Content="🔄  تحويل بين الصناديق" Click="CashTransfer_Click"/>
                    <Button Content="↔  السندات والمدفوعات" Click="Payments_Click"/>
                    <Button Content="📒  الحسابات والقيود" Click="Accounting_Click"/>
                    <Button Content="💸  المصروفات" Click="Expenses_Click"/>
                    <Button Content="📖  دليل الحسابات" Click="ChartOfAccounts_Click"/>
                    <Button Content="📊  التقارير" Click="Reports_Click"/>
                    <Button Content="📚  التقارير المالية" Click="FinancialReports_Click"/>
                    <Button Content="💱  أسعار الصرف" Click="ExchangeRates_Click"/>
                    <Button Content="📋  كشف الحساب" Click="Statements_Click"/>
                    <Button Content="👥  المستخدمون والصلاحيات" Click="Users_Click"/>
                    <Button Content="📥  استيراد بيانات Android" Click="ImportAndroid_Click"/>
                    <Button Content="🛡  سجل التدقيق" Click="AuditLog_Click"/>
                    <Button Content="🏦  الإدارة المالية المتقدمة" Click="Enterprise_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="⚙  الإعدادات" Click="Settings_Click"/>
                    <TextBlock Text="إصدار سطح المكتب 0.1.0" Foreground="#64748B" FontSize="11" Margin="8,18,8,4"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="34">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,25">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock x:Name="PageTitle" Text="لوحة التحكم" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="PageSubtitle" Text="نظرة عامة على نشاط المنشأة" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="متصل محليًا" Foreground="#16A34A" VerticalAlignment="Center" FontSize="14"/>
            </DockPanel>
            <Grid x:Name="ContentHost" Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="مبيعات اليوم" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SalesTotal" Text="0.00" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="مشتريات اليوم" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PurchaseTotal" Text="0.00" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="رصيد الصندوق" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CashTotal" Text="0.00" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="قيمة المخزون" Foreground="{StaticResource Muted}"/><TextBlock x:Name="InventoryTotal" Text="0.00" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,15,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="آخر الفواتير" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <ListView x:Name="RecentInvoicesList" BorderThickness="0" MouseDoubleClick="RecentInvoice_DoubleClick">
                                    <ListView.View><GridView>
                                        <GridViewColumn Header="رقم الفاتورة" DisplayMemberBinding="{Binding Number}" Width="150"/>
                                        <GridViewColumn Header="النوع" DisplayMemberBinding="{Binding TypeLabel}" Width="120"/>
                                        <GridViewColumn Header="الطرف" DisplayMemberBinding="{Binding PartyName}" Width="170"/>
                                        <GridViewColumn Header="التاريخ" DisplayMemberBinding="{Binding DateLabel}" Width="145"/>
                                        <GridViewColumn Header="الإجمالي" DisplayMemberBinding="{Binding TotalLabel}" Width="120"/>
                                    </GridView></ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24">
                            <StackPanel><TextBlock Text="اختصارات" FontSize="20" FontWeight="SemiBold"/><Button Content="＋ فاتورة مبيعات" Click="Sales_Click" Foreground="{StaticResource Text}" Background="#EEF2FF" HorizontalContentAlignment="Center" Margin="0,15,0,5"/><Button Content="＋ إضافة منتج" Click="Products_Click" Foreground="{StaticResource Text}" Background="#F1F5F9" HorizontalContentAlignment="Center"/><Button Content="＋ عميل / مورد" Click="Parties_Click" Foreground="{StaticResource Text}" Background="#F1F5F9" HorizontalContentAlignment="Center"/><Button Content="🧮 جرد وتسوية" Click="InventoryAudit_Click" Foreground="{StaticResource Text}" Background="#F1F5F9" HorizontalContentAlignment="Center" Margin="0,5,0,0"/><Button Content="🔄 تحويل بين الصناديق" Click="CashTransfer_Click" Foreground="{StaticResource Text}" Background="#F1F5F9" HorizontalContentAlignment="Center"/><Button Content="🧱 طبقات التكلفة" Click="CostLayers_Click" Foreground="{StaticResource Text}" Background="#F1F5F9" HorizontalContentAlignment="Center"/></StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
