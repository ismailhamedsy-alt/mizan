<Window x:Class="MizanDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الميزان للمحاسبة" Width="1500" Height="950" MinWidth="1000" MinHeight="650"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Sidebar}">
            <DockPanel Margin="12" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="6,4,6,16">
                    <TextBlock Text="الميزان" Foreground="White" FontSize="31" FontWeight="Bold" Margin="8,10,8,2"/>
                    <TextBlock Text="نظام المحاسبة وإدارة المبيعات" Foreground="#CBD5E1" FontSize="12"
                               TextWrapping="Wrap" Margin="8,0,8,5"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="⚙  الإعدادات" Click="Settings_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="إصدار سطح المكتب 0.2.0 · .NET 10" Foreground="#CBD5E1"
                               FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="4,10,4,4"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True" Focusable="False">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource NavButton}"/>
                        </StackPanel.Resources>
                        <Button Content="⌂  لوحة التحكم" Click="Dashboard_Click"/>
                        <Button Content="▣  المبيعات" Click="Sales_Click"/>
                        <Button Content="↩  مرتجعات المبيعات" Click="SalesReturns_Click"/>
                        <Button Content="🧾  عروض الأسعار" Click="Quotations_Click"/>
                        <Button Content="▤  المشتريات" Click="Purchases_Click"/>
                        <Button Content="↪  مرتجعات المشتريات" Click="PurchaseReturns_Click"/>
                        <Button Content="▦  المنتجات والمخزون" Click="Products_Click"/>
                        <Button Content="♙  العملاء والموردون" Click="Parties_Click"/>
                        <Button Content="💰  الصندوق" Click="Cash_Click"/>
                        <Button Content="📦  الجرد والمخزون" Click="Inventory_Click"/>
                        <Button Content="🧮  الجرد والتسوية" Click="InventoryAudit_Click"/>
                        <Button Content="🧱  طبقات تكلفة المخزون" Click="CostLayers_Click"/>
                        <Button Content="🔄  تحويل بين الصناديق" Click="CashTransfer_Click"/>
                        <Button Content="↔  السندات والمدفوعات" Click="Payments_Click"/>
                        <Button Content="📒  الحسابات والقيود" Click="Accounting_Click"/>
                        <Button Content="💸  المصروفات" Click="Expenses_Click"/>
                        <Button Content="📖  دليل الحسابات" Click="ChartOfAccounts_Click"/>
                        <Button Content="📊  التقارير" Click="Reports_Click"/>
                        <Button Content="📚  التقارير المالية" Click="FinancialReports_Click"/>
                        <Button Content="💱  أسعار الصرف" Click="ExchangeRates_Click"/>
                        <Button Content="📋  كشف الحساب" Click="Statements_Click"/>
                        <Button Content="👥  المستخدمون والصلاحيات" Click="Users_Click"/>
                        <Button Content="📥  استيراد بيانات Android" Click="ImportAndroid_Click"/>
                        <Button Content="🛡  سجل التدقيق" Click="AuditLog_Click"/>
                        <Button Content="🏦  الإدارة المالية المتقدمة" Click="Enterprise_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock x:Name="PageTitle" Text="لوحة التحكم" FontSize="29" FontWeight="Bold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="PageSubtitle" Text="نظرة عامة على نشاط المنشأة"
                               Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                        CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="●  يعمل محليًا" Foreground="#166534" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>

            <Grid x:Name="ContentHost" Grid.Row="1" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <StackPanel>
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="مبيعات اليوم" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SalesTotal" Text="0.00" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="مشتريات اليوم" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PurchaseTotal" Text="0.00" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="رصيد الصندوق" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CashTotal" Text="0.00" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel><TextBlock Text="قيمة المخزون" Foreground="{StaticResource Muted}"/><TextBlock x:Name="InventoryTotal" Text="0.00" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="ل.س" Foreground="{StaticResource Muted}"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="10" Padding="18" Margin="0,0,12,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="آخر الفواتير" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <ListView x:Name="RecentInvoicesList" BorderThickness="0" Height="420"
                                              MouseDoubleClick="RecentInvoice_DoubleClick">
                                        <ListView.View><GridView>
                                            <GridViewColumn Header="رقم الفاتورة" DisplayMemberBinding="{Binding Number}" Width="135"/>
                                            <GridViewColumn Header="النوع" DisplayMemberBinding="{Binding TypeLabel}" Width="105"/>
                                            <GridViewColumn Header="الطرف" DisplayMemberBinding="{Binding PartyName}" Width="150"/>
                                            <GridViewColumn Header="التاريخ" DisplayMemberBinding="{Binding DateLabel}" Width="140"/>
                                            <GridViewColumn Header="الإجمالي" DisplayMemberBinding="{Binding TotalLabel}" Width="105"/>
                                        </GridView></ListView.View>
                                    </ListView>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="اختصارات" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Button Content="＋ فاتورة مبيعات" Click="Sales_Click" Margin="0,6,0,0"/>
                                    <Button Content="＋ إضافة منتج" Click="Products_Click" Margin="0,6,0,0"/>
                                    <Button Content="＋ عميل / مورد" Click="Parties_Click" Margin="0,6,0,0"/>
                                    <Button Content="🧮 جرد وتسوية" Click="InventoryAudit_Click" Margin="0,6,0,0"/>
                                    <Button Content="🔄 تحويل بين الصناديق" Click="CashTransfer_Click" Margin="0,6,0,0"/>
                                    <Button Content="🧱 طبقات التكلفة" Click="CostLayers_Click" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
