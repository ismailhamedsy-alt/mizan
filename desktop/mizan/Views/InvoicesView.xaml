<UserControl x:Class="MizanDesktop.Views.InvoicesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
<Grid Margin="4">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,14">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="فاتورة جديدة" Click="New_Click" Padding="20,10"/>
   <Button Content="تحديث" Click="Refresh_Click" Padding="18,10" Margin="8,0,0,0"/>
  </StackPanel>
  <TextBox x:Name="SearchBox" Width="280" Padding="8" TextChanged="Search_TextChanged" ToolTip="بحث برقم الفاتورة أو اسم الطرف" HorizontalAlignment="Left"/>
 </DockPanel>
 <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
  <DataGrid.Columns>
   <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="150"/>
   <DataGridTextColumn Header="التاريخ" Binding="{Binding Date,StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
   <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="130"/>
   <DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}" Width="*"/>
   <DataGridTextColumn Header="الخصم" Binding="{Binding Discount,StringFormat=N2}" Width="100"/>
   <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total,StringFormat=N2}" Width="130"/>
   <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount,StringFormat=N2}" Width="120"/>
   <DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining,StringFormat=N2}" Width="120"/>
   <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="120"/>
  </DataGrid.Columns>
 </DataGrid>
 <DockPanel Grid.Row="2" Margin="0,12,0,0">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="تفاصيل" Click="Details_Click" Padding="16,8" Margin="0,0,6,0"/>
   <Button Content="طباعة" Click="Print_Click" Padding="16,8" Margin="0,0,6,0"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
   <TextBlock Text="إجمالي الظاهر: " FontWeight="Bold"/><TextBlock x:Name="TotalText" FontWeight="Bold" Margin="5,0,25,0"/>
   <TextBlock Text="عدد الفواتير: " FontWeight="Bold"/><TextBlock x:Name="CountText" FontWeight="Bold" Margin="5,0,0,0"/>
  </StackPanel>
 </DockPanel>
</Grid>
</UserControl>
