<UserControl x:Class="MizanDesktop.Views.AccountingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
<Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="دفتر اليومية" FontSize="22" FontWeight="SemiBold"/><Button Content="تحديث" Click="Refresh_Click" Margin="20,0,0,0" Padding="18,6"/></StackPanel>
 <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
  <DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding Date,StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="150"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit,StringFormat=N2}" Width="130"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit,StringFormat=N2}" Width="130"/></DataGrid.Columns>
 </DataGrid>
</Grid></UserControl>
