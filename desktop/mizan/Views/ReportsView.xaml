<UserControl x:Class="MizanDesktop.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
<Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,15"><TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="FromPicker" Width="150"/><TextBlock Text="إلى" VerticalAlignment="Center" Margin="18,0,8,0"/><DatePicker x:Name="ToPicker" Width="150"/><Button Content="تحديث التقرير" Click="Refresh_Click" Margin="18,0,0,0" Padding="18,8"/><Button Content="تصدير CSV" Click="Export_Click" Margin="8,0,0,0" Padding="18,8"/><Button Content="Excel XLSX" Click="ExportXlsx_Click" Margin="8,0,0,0" Padding="18,8"/><Button Content="طباعة" Click="Print_Click" Margin="8,0,0,0" Padding="18,8"/></WrapPanel>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15"><Border Background="White" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="صافي المبيعات"/><TextBlock x:Name="Sales" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="مجمل الربح"/><TextBlock x:Name="Profit" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="صافي المشتريات"/><TextBlock x:Name="Purchases" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" Padding="16"><StackPanel><TextBlock Text="حالة ميزان المراجعة"/><TextBlock x:Name="BalanceStatus" FontSize="18" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
<TabControl Grid.Row="2"><TabItem Header="الأرباح والخسائر"><DataGrid x:Name="ProfitGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="البند" Binding="{Binding Item}"/><DataGridTextColumn Header="القيمة" Binding="{Binding Value,StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="ميزان المراجعة"><DataGrid x:Name="TrialGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="الحساب" Binding="{Binding Account}"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit,StringFormat=N2}"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit,StringFormat=N2}"/><DataGridTextColumn Header="الصافي" Binding="{Binding Net,StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="الفواتير"><DataGrid x:Name="InvoiceGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding Date,StringFormat=yyyy-MM-dd HH:mm}"/><DataGridTextColumn Header="الرقم" Binding="{Binding Number}"/><DataGridTextColumn Header="النوع" Binding="{Binding Type}"/><DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding Total,StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
</Grid></UserControl>
