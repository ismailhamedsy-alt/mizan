<UserControl x:Class="MizanDesktop.Views.PaymentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
<Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="سند قبض / سند صرف" FontSize="22" FontWeight="Bold"/><WrapPanel Margin="0,14,0,0"><ComboBox x:Name="TypeBox" Width="170" SelectedIndex="0"><ComboBoxItem>قبض من عميل</ComboBoxItem><ComboBoxItem>دفع لمورد</ComboBoxItem><ComboBoxItem>إيراد نقدي</ComboBoxItem><ComboBoxItem>مصروف نقدي</ComboBoxItem></ComboBox><ComboBox x:Name="PartyBox" Width="220" Margin="8,0" DisplayMemberPath="Name"/><TextBox x:Name="AmountBox" Width="150" Margin="8,0"/><TextBox x:Name="DescriptionBox" Width="280" Margin="8,0"/><Button Content="حفظ السند" Click="Save_Click" Padding="20,8"/></WrapPanel></StackPanel></Border>
<DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding Date,StringFormat=yyyy-MM-dd HH:mm}"/><DataGridTextColumn Header="النوع" Binding="{Binding Type}"/><DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount,StringFormat=N2}"/><DataGridTextColumn Header="البيان" Binding="{Binding Description}"/></DataGrid.Columns></DataGrid></Grid></UserControl>
