<UserControl x:Class="MizanDesktop.Views.StatementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="كشف حساب" FontSize="22" FontWeight="Bold" Margin="0,0,25,0"/><ComboBox x:Name="PartyBox" Width="260" DisplayMemberPath="Name"/><DatePicker x:Name="From" Margin="10,0"/><DatePicker x:Name="To"/><Button Content="عرض" Click="Load_Click" Margin="10,0" Padding="20,5"/><Button Content="طباعة" Click="Print_Click" Padding="20,5"/></StackPanel>
  <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding Date,StringFormat=yyyy-MM-dd}"/><DataGridTextColumn Header="النوع" Binding="{Binding Kind}"/><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}"/><DataGridTextColumn Header="البيان" Binding="{Binding Description}"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit,StringFormat=N2}"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit,StringFormat=N2}"/><DataGridTextColumn Header="الرصيد" Binding="{Binding Balance,StringFormat=N2}"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
