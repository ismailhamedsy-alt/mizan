<UserControl x:Class="MizanDesktop.Views.ProductsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
<Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15"><DockPanel>
<StackPanel DockPanel.Dock="Right"><TextBlock Text="المنتجات والمخزون" FontSize="25" FontWeight="Bold"/><TextBlock Text="إدارة الأصناف والكميات والأسعار" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="＋ منتج جديد" Click="Add_Click" Padding="18,10" Margin="5"/><Button Content="تحديث" Click="Refresh_Click" Padding="18,10" Margin="5"/></StackPanel></DockPanel></Border>
<Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15"><DockPanel>
<TextBox x:Name="SearchBox" DockPanel.Dock="Top" Height="38" Margin="0,0,0,12" Padding="10" TextChanged="Search_TextChanged" ToolTip="ابحث بالاسم أو الباركود أو الكود"/>
<DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns>
<DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130"/><DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="90"/><DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice,StringFormat=N2}" Width="110"/><DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice,StringFormat=N2}" Width="110"/><DataGridTextColumn Header="المخزون" Binding="{Binding Quantity,StringFormat=N2}" Width="100"/><DataGridTemplateColumn Header="إجراء" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="تعديل" Click="Edit_Click" Tag="{Binding}" Margin="2"/><Button Content="حذف" Click="Delete_Click" Tag="{Binding}" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid></DockPanel></Border></Grid></UserControl>
