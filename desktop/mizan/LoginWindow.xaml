<Window x:Class="MizanDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - الميزان"
        Width="540" Height="500" MinWidth="500" MinHeight="470"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        ResizeMode="CanResize" Background="{StaticResource Bg}">
    <Grid Margin="22">
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16"
                Padding="30" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="الميزان" FontSize="34" FontWeight="Bold" Foreground="#1D4ED8"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Text="نظام المحاسبة وإدارة المبيعات" FontSize="15" Foreground="#475569"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    <TextBlock Text="اسم المستخدم" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="User" Text="admin" Height="42" Margin="0,0,0,14"
                             AutomationProperties.Name="اسم المستخدم"/>
                    <TextBlock Text="رمز الدخول (PIN)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="Pin" Height="42" Margin="0,0,0,18"
                                 AutomationProperties.Name="رمز الدخول"/>
                    <TextBlock Text="يمكن إدخال أرقام PIN بالأرقام العربية أو الإنجليزية." Foreground="#334155" Margin="2,0,2,12"/>
                    <Button Content="دخول إلى البرنامج" Click="Login_Click" Height="44" FontSize="16"
                            IsDefault="True" Margin="0,0,0,9"/>
                    <Button Content="استعادة دخول المدير إلى البيانات الافتراضية"
                            Click="RecoverAdmin_Click" Height="42" Background="#9A3412"
                            BorderBrush="#9A3412" Foreground="White" Margin="0,0,0,12"/>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="بيانات الدخول الافتراضية" Foreground="#1E40AF" FontWeight="Bold"/>
                            <TextBlock Text="اسم المستخدم: admin" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                            <TextBlock Text="رمز الدخول: 1234" Foreground="#1E3A8A"/>
                            <TextBlock Text="إذا لم يعمل الرمز، استخدم زر الاستعادة أعلاه. لن تُحذف الفواتير أو بيانات المنشأة."
                                       TextWrapping="Wrap" Foreground="#334155" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
